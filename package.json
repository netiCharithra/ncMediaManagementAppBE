{
  "name": "viva-digital-news-backend",
  "version": "1.0.0",
  "description": "Vishwa Vani Digital News - Hyperlocal News Distribution Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:api-only": "DISABLE_CRON=true nodemon src/server.js",
    "dev:no-rss": "DISABLE_RSS=true nodemon src/server.js",
    "worker:rss": "node src/workers/rss_ingestion_worker.js",
    "worker:summarize": "node src/workers/summarization_worker.js",
    "worker:translate": "node src/workers/translation_worker.js",
    "worker:images": "node src/workers/newsWorker.js",
    "worker:all": "npm run worker:rss && npm run worker:summarize && npm run worker:translate",
    "worker:process": "npm run worker:summarize && npm run worker:translate",
    "db:clear": "node src/scripts/clear_news.js",
    "lint": "eslint src/",
    "test": "jest --runInBand"
  },
  "keywords": [
    "news",
    "hyperlocal",
    "telugu",
    "backend"
  ],
  "author": "Viva Digital News Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@google-cloud/logging-winston": "^6.0.1",
    "@google/genai": "^1.46.0",
    "@huggingface/inference": "^4.13.15",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "cloudinary": "^2.9.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^4.3.4",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.1",
    "mongoose": "^8.2.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.12.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
